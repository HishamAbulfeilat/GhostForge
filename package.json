{
  "name": "ghostforge",
  "version": "5.3.2",
  "private": true,
  "bin": {
    "ghostforge": "bin/ghostforge"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.js",
    "test": "node scripts/test.js",
    "monitor": "node tools/dev-monitor/server.mjs",
    "test:monitor": "node --test tools/dev-monitor/server.test.mjs",
    "agents:setup": "node scripts/agents/boss.mjs setup",
    "ecc:setup": "node scripts/agents/ecc-setup.mjs",
    "agents:start": "node scripts/agents/boss.mjs start",
    "agents:status": "node scripts/agents/team.mjs status",
    "agents:stop": "node scripts/agents/team.mjs stop",
    "agents:watchdog": "node scripts/agents/watchdog.mjs",
    "test:agents": "node --test scripts/agents/*.test.mjs scripts/agents/lib/*.test.mjs",
    "awesome-llm-apps": "node scripts/awesome-llm-apps.mjs",
    "test:awesome-llm-apps": "node --test scripts/awesome-llm-apps.test.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.21.1"
  }
}
