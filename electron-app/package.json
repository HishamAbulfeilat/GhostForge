{
  "name": "ghostforge-jarvis",
  "version": "5.2.0",
  "description": "GhostForge JARVIS — Ultimate AI Desktop Assistant with Screen Vision, Voice Control, and Blue Cursor",
  "author": {
    "name": "Hisham Abulfeilat",
    "email": "hisham@ghostforge.dev"
  },
  "homepage": "https://github.com/HishamAbulfeilat/GhostForge",
  "repository": {
    "type": "git",
    "url": "https://github.com/HishamAbulfeilat/GhostForge.git"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "build:mac": "tsc && electron-builder --mac --publish never",
    "build:win": "tsc && electron-builder --win --publish never",
    "build:linux": "tsc && electron-builder --linux --publish never",
    "build:all": "tsc && electron-builder -mwl --publish never",
    "build:android": "bash scripts/build-android.sh",
    "start": "electron .",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "mammoth": "^1.12.0",
    "node-screenshots": "^0.0.12",
    "pdf-parse": "^1.1.4",
    "playwright": "^1.62.0",
    "sharp": "^0.33.2",
    "systeminformation": "^5.33.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.ghostforge.jarvis",
    "productName": "GhostForge JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ]
  }
}
