      "position": [3520, 340]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/pulls/{{ $json.pr_number }}/reviews",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"body\":\"## ✅ GhostForge Agent — Auto-Approve\\n\\nAll automated checks have passed:\\n- Lint: ✅\\n- TypeCheck: ✅\\n- Tests: ✅\\n\\nApproving this PR for merge.\",\"event\":\"APPROVE\"}",
        "options": {}
      },
      "id": "auto-approve-pr",
      "name": "Auto-Approve PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [3740, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub API Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const repo = $input.first().json.repo;\nconst prNumber = $input.first().json.pr_number;\n\n// Cleanup: remove cloned repo\nreturn [{ json: { cleanup: 'rm -rf /tmp/gf-test-' + prNumber, repo, pr_number: prNumber } }];"
      },
      "id": "cleanup-repo",
      "name": "Cleanup Temp Repo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3960, 240]
    }
  ],
