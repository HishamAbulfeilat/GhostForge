{
  "version": 2,
  "builds": [{ "src": "index.js", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "index.js" }],
  "env": {
    "GITHUB_APP_ID": "@ghostforge-github-app-id",
    "WEBHOOK_SECRET": "@ghostforge-webhook-secret",
    "GITHUB_PRIVATE_KEY": "@ghostforge-github-private-key"
  }
}
