{
  "name": "ghostforge-ai",
  "displayName": "GhostForge AI Developer Toolkit",
  "description": "GitHub Copilot supercharger for React/Next.js/TypeScript \u2014 commands, snippets, RTL audit, bundle analyzer, and more",
  "version": "2.6.0",
  "publisher": "ghostforge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "ghostforge",
    "copilot",
    "nextjs",
    "react",
    "typescript",
    "snippets",
    "rtl"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.js",
    "build:min": "node esbuild.js --minify",
    "compile": "tsc --noEmit",
    "package": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "ghostforge.openPicker",
        "title": "GhostForge: Open Command Picker",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.context",
        "title": "GhostForge: /context \u2014 Read current file as context",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.rtl",
        "title": "GhostForge: /rtl \u2014 RTL Audit (dry run)",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.rtlFix",
        "title": "GhostForge: /rtl --fix \u2014 RTL Auto-fix",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.bundle",
        "title": "GhostForge: /bundle \u2014 Bundle Analyzer",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.health",
        "title": "GhostForge: /health \u2014 Project Health Check",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.storybook",
        "title": "GhostForge: /storybook \u2014 Generate Stories for this file",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.ticket",
        "title": "GhostForge: /ticket \u2014 Scaffold from Ticket ID",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.snippet",
        "title": "GhostForge: /snippet \u2014 Insert Snippet at Cursor",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.commit",
        "title": "GhostForge: /commit \u2014 Generate Commit Message",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.review",
        "title": "GhostForge: /review \u2014 Code Review",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.test",
        "title": "GhostForge: /test \u2014 Run Tests",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.security",
        "title": "GhostForge: /security \u2014 Security Audit",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.optimize",
        "title": "GhostForge: /optimize \u2014 Optimize Code",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.docs",
        "title": "GhostForge: /docs \u2014 Generate Docs",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.i18n",
        "title": "GhostForge: /i18n \u2014 i18n Translation Check",
        "category": "GhostForge AI"
      },
      {
        "command": "ghostforge.refreshSnippets",
        "title": "GhostForge: Refresh Snippets",
        "category": "GhostForge AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ghostforge.context",
          "group": "navigation@20",
          "when": "editorTextFocus && (resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .jsx)"
        },
        {
          "command": "ghostforge.storybook",
          "group": "navigation@21",
          "when": "editorTextFocus && (resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .jsx)"
        }
      ],
      "explorer/context": [
        {
          "command": "ghostforge.rtl",
          "group": "navigation@20",
          "when": "resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .jsx || explorerResourceIsFolder"
        },
        {
          "command": "ghostforge.bundle",
          "group": "navigation@21",
          "when": "resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .jsx || explorerResourceIsFolder"
        },
        {
          "command": "ghostforge.health",
          "group": "navigation@22",
          "when": "resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .jsx || explorerResourceIsFolder"
        }
      ],
      "view/item/context": [
        {
          "command": "ghostforge.refreshSnippets",
          "when": "view == ghostforge.snippets",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghostforge-ai",
          "title": "GhostForge AI",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "ghostforge-ai": [
        {
          "id": "ghostforge.snippets",
          "name": "Snippets"
        },
        {
          "id": "ghostforge.commands",
          "name": "Commands"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ghostforge.openPicker",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HishamAbulfeilat/GhostForge"
  },
  "homepage": "https://github.com/HishamAbulfeilat/GhostForge"
}