# GitHub App credentials (from https://github.com/settings/apps)
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxx
WEBHOOK_SECRET=your-random-webhook-secret
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Server config
PORT=3000
NODE_ENV=development

# Optional: restrict to specific org (leave blank for public)
ALLOWED_ORG=ghostforge
