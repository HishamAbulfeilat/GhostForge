#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  ghostforge  —  GhostForge CLI Launcher
#  Operator-grade dev tools, forged in the shadows.
# ═══════════════════════════════════════════════════════════════
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TUI_DIR="$SCRIPT_DIR/tui"
VERSION="$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "4.0.0")"

if ! command -v node &>/dev/null; then
  echo "❌  Node.js is required. Install from https://nodejs.org/"
  exit 1
fi

NODE_MAJOR=$(node -e "console.log(process.versions.node.split('.')[0])")
if [ "$NODE_MAJOR" -lt 18 ]; then
  echo "❌  Node.js 18+ required (you have $(node --version)). Upgrade at https://nodejs.org/"
  exit 1
fi

if [ ! -d "$TUI_DIR/node_modules" ]; then
  echo "⏳  Installing GhostForge TUI dependencies (first run only)..."
  cd "$TUI_DIR" && npm install --silent
fi

print_help() {
  cat <<EOF
GhostForge v$VERSION
Operator-grade dev tools, forged in the shadows.

Usage:
  ghostforge                Launch the TUI
  ghostforge -v|--version   Print toolkit version
  ghostforge -h|--help      Show this help
  ghostforge <command>      Run scripts/<command>.sh
  ghostforge --open PATH    Run open-project.sh directly
  ghostforge --command health [PATH]
  ghostforge --command security [PATH]
  ghostforge --digest [PATH]
  gf                        Alias for ghostforge
EOF
}

if [[ $# -gt 0 && "${1#-}" == "$1" ]]; then
  subcommand="$1"
  subcommand_script="$SCRIPT_DIR/scripts/${subcommand}.sh"

  if [[ -f "$subcommand_script" ]]; then
    shift
    GF_NON_INTERACTIVE=1 bash "$subcommand_script" "$@"
    exit $?
  fi

  echo "Unknown command: $subcommand. Run 'ghostforge --help' for usage."
  exit 1
fi

case "${1:-}" in
  -v|--version)
    echo "$VERSION"
    exit 0
    ;;
  -h|--help)
    print_help
    exit 0
    ;;
  --open)
    shift
    bash "$SCRIPT_DIR/scripts/open-project.sh" "${1:-$(pwd)}"
    exit $?
    ;;
  --command)
    shift
    command_name="${1:-}"
    shift || true
    script_path=""
    case "$command_name" in
      health)
        script_path="$SCRIPT_DIR/scripts/health-check.sh"
        ;;
      security)
        script_path="$SCRIPT_DIR/scripts/security-check.sh"
        ;;
      '')
        echo "❌  Missing command name after --command"
        exit 1
        ;;
      *)
        script_path="$SCRIPT_DIR/scripts/${command_name}.sh"
        ;;
    esac

    if [[ -f "$script_path" ]]; then
      GF_NON_INTERACTIVE=1 bash "$script_path" "$@"
      exit $?
    fi

    echo "❌  Unsupported command: $command_name"
    exit 1
    ;;
  --digest)
    shift
    bash "$SCRIPT_DIR/scripts/daily-digest.sh" "${1:-$(pwd)}"
    exit $?
    ;;
esac

cd "$SCRIPT_DIR"
node "$TUI_DIR/index.js" "$@"
