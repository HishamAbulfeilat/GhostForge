{
  "$schema": "https://opencode.ai/config.json",

  "lsp": true,

  "formatter": true,

  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**",
      "release/**",
      "electron-app/release/**",
      "electron-app/node_modules/**",
      ".git/**",
      "coverage/**"
    ]
  },

  "permission": {
    "bash": "ask",
    "write": "ask",
    "edit": "ask"
  },

  "instructions": [
    "CLAUDE.md",
    "CHANGELOG.md"
  ]
}
