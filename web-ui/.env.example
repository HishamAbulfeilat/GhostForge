# Required
ACCESS_PIN=your-secret-pin
AUTH_SECRET=any-random-string-32-chars

# AI - add at least one:
OPENROUTER_API_KEY=sk-or-...         # From openrouter.ai/keys (free models available)
GOOGLE_GENERATIVE_AI_API_KEY=AIza... # From aistudio.google.com (free)

# Optional - Mac bridge for remote command execution:
WS_BRIDGE_URL=https://xxxx.trycloudflare.com
WS_BRIDGE_TOKEN=your-bridge-token

# Optional - specify AI model
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional - JARVIS movie-accurate voice (free tier available)
FISH_AUDIO_API_KEY=your-fish-audio-key          # From fish.audio (free credits, no quota limits)
FISH_AUDIO_JARVIS_MODEL=36b6f66cfecf466caac7fcba1f8b59c8 # JARVIS voice model id

# Optional - local runtimes (offline mode never calls cloud providers)
OLLAMA_URL=http://localhost:11434
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local-model
