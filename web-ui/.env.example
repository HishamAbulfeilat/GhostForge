# Required
# ACCESS_PIN signs in as the owner: use at least 8 characters (shorter PINs of
# 4+ still work but log a warning). PIN failures are rate-limited globally.
ACCESS_PIN=your-secret-pin
AUTH_SECRET=any-random-string-32-chars

# Security (optional)
# Trust X-Real-IP / X-Forwarded-For / CF-Connecting-IP for the client address
# (rate limits, login lockouts). Set to 1 ONLY when GhostForge is reachable
# solely through a reverse proxy that overwrites those headers; otherwise any
# client can forge them. Default: use the TCP socket address (server.js).
# TRUSTED_PROXY=1
# Folder that non-admin accounts can browse/edit in Files (default ~/GhostForge).
# Dotfiles, ~/.ghostforge and ~/.ssh are never exposed to non-admins.
# GF_FILES_ROOT=~/GhostForge
# Lock the host PC when a signed-in user tries to cross a privilege boundary
# (e.g. a non-owner editing users). Off by default; anonymous requests,
# bad cookies and failed logins never lock the PC.
# GF_LOCK_ON_UNAUTHORIZED=1

# Users & admin (multi-user auth)
# The default admin is created on first run when no admin exists yet.
ADMIN_USERNAME=hisham              # default admin username
ADMIN_PASSWORD=your-admin-password # default admin password (first run only)
ADMIN_NAME=Hisham                  # default admin display name

# AI - add at least one:
OPENROUTER_API_KEY=sk-or-...         # From openrouter.ai/keys (free models available)
GOOGLE_GENERATIVE_AI_API_KEY=AIza... # From aistudio.google.com (free)

# Optional - Mac bridge for remote command execution:
WS_BRIDGE_URL=https://xxxx.trycloudflare.com
WS_BRIDGE_TOKEN=your-bridge-token

# Optional - specify AI model
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional - JARVIS movie-accurate voice (free tier available)
FISH_AUDIO_API_KEY=your-fish-audio-key          # From fish.audio (free credits, no quota limits)
FISH_AUDIO_JARVIS_MODEL=36b6f66cfecf466caac7fcba1f8b59c8 # JARVIS voice model id

# Optional - local runtimes (offline mode never calls cloud providers)
OLLAMA_URL=http://localhost:11434
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local-model

# Job Hunter — LinkedIn / Indeed / Glassdoor listings via JSearch (free key: search "JSearch" on rapidapi.com)
# JSEARCH_API_KEY=
# Browser used to fill applications (defaults to installed Chrome, then Edge)
# JOB_HUNTER_BROWSER=
# 1 = always fill applications in a background (headless) browser, even with "Allow control of this
# computer" on. Without a display (no DISPLAY/WAYLAND_DISPLAY on Linux) it is always headless.
# JOB_HUNTER_HEADLESS=
