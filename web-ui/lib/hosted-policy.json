    {"path": "/api/jarvis/memory"},
    {"path": "/api/jarvis/inbox", "exact": true},
    {"path": "/api/jarvis/collab", "exact": true},
    {"path": "/api/models", "exact": true},
    {"path": "/api/models/keys", "exact": true},
    {"path": "/api/models/custom", "exact": true},
    {"path": "/api/users", "exact": true},
    {"path": "/api/setup", "exact": true},
    {"path": "/api/jobs", "exact": true},
    {"path": "/api/jobs/cv", "exact": true},
    {"path": "/api/jobs/profile", "exact": true},
    {"path": "/api/marketplace", "exact": true, "methods": ["GET", "HEAD"]},
    {"path": "/api/snippets", "exact": true},
    {"path": "/api/huggingface", "exact": true},
    {"path": "/api/awesome-llm-apps", "exact": true}
