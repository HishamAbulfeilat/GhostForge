# GhostForge hosted ("friends") mode. See docs/HOSTING.md.
# Copy into your host's secret/env settings (Codespaces secrets, Render/Fly/
# Koyeb env vars, a systemd EnvironmentFile or `docker run --env-file`).
# Never commit the filled-in file. Comments stay on their own lines because
# docker --env-file does not strip inline comments.

GHOSTFORGE_MODE=hosted
NODE_ENV=production

# Required: the server refuses to start without these.
# AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=
# ADMIN_PASSWORD: 12+ characters; seeds the admin account on first start only
ADMIN_PASSWORD=

# Optional: admin login and display name (defaults "admin" / "Admin" when hosted)
ADMIN_USERNAME=admin
ADMIN_NAME=Admin

# Optional: listen address. Use HOST=127.0.0.1 when a tunnel (cloudflared,
# tailscale) runs on the same machine, so only the tunnel can reach it.
PORT=3001
HOST=0.0.0.0

# Optional: where users, per-user AI keys and memory live (default web-ui/.hosted-data)
# GHOSTFORGE_DATA_DIR=/data

# Do NOT put AI or integration keys here (OPENROUTER_API_KEY, GITHUB_TOKEN...).
# Hosted mode ignores and removes them; each friend adds their own key in
# Settings > AI Models, or uses the free keyless models.
