{
  "name": "ghostforge-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo '0.0.0.0') && echo \"\\n  ➜ Network:  http://$IP:3001\\n\" && next dev --hostname 0.0.0.0 --port 3001",
    "dev:https": "NODE_ENV=development node server.js",
    "build": "next build",
    "start": "node server.js",
    "start:next": "next start",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/openai": "^4.0.78",
    "@anthropic-ai/sdk": "^0.128.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.118",
    "clsx": "^2.1.1",
    "docx": "^9.7.2",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.26",
    "novnc-next": "^1.0.0",
    "playwright-core": "^1.63.0",
    "react": "^18",
    "react-dom": "^18",
    "socket.io-client": "^4.7.5",
    "unpdf": "^1.8.1",
    "ws": "^8.21.1",
    "xterm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
