{
  "$comment": "Agent team config — read by scripts/agents/boss.mjs. Paths are relative to the repo root. Models: a tier table per provider (deep/balanced/fast); 'auto' lets the provider choose. Task kind → tier lives in scripts/agents/lib/models.mjs.",
  "boss": {
    "provider": "claude",
    "model": "opus",
    "reviewModel": "sonnet",
    "planModel": "opus",
    "deepReviewOverLines": 600,
    "review": true,
    "fallback": "copilot",
    "fallbackModel": "auto"
  },
  "integration": {
    "branch": "agent/integration",
    "worktree": "../gf-integration",
    "base": "main"
  },
  "agents": {
    "claude": {
      "provider": "claude",
      "enabled": false,
      "worktree": "../gf-claude",
      "branch": "agent/claude/work",
      "strengths": [
        "plan",
        "architecture",
        "security",
        "review",
        "refactor",
        "test",
        "bugfix"
      ]
    },
    "copilot-tui": {
      "provider": "copilot",
      "enabled": true,
      "worktree": "../gf-boss-tui",
      "branch": "agent/copilot/boss-tui",
      "strengths": [
        "test",
        "bugfix",
        "feature"
      ]
    },
    "copilot-desktop": {
      "provider": "copilot",
      "enabled": true,
      "worktree": "../gf-boss-desktop",
