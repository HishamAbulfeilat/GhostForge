{
  "$comment": "Agent team config — read by scripts/agents/boss.mjs. Paths are relative to the repo root. Models: a tier table per provider (deep/balanced/fast); 'auto' lets the provider choose. Task kind → tier lives in scripts/agents/lib/models.mjs.",
  "boss": { "provider": "copilot", "model": "auto", "review": true },
  "integration": { "branch": "agent/integration", "worktree": "../gf-integration", "base": "main" },
  "agents": {
    "claude":  { "provider": "claude",  "enabled": false, "worktree": "../gf-claude", "branch": "agent/claude/work", "strengths": ["plan", "architecture", "security", "review", "refactor", "test", "bugfix"] },
    "copilot": { "provider": "copilot", "enabled": true,  "worktree": "../gf-boss-copilot", "branch": "agent/copilot/boss", "strengths": ["feature", "bugfix", "test", "docs", "chore", "security", "refactor"] },
    "copilot-qa": { "provider": "copilot", "enabled": true, "worktree": "../gf-boss-copilot-qa", "branch": "agent/copilot/boss-qa", "strengths": ["test", "bugfix", "chore"] },
    "copilot-security": { "provider": "copilot", "enabled": true, "worktree": "../gf-boss-copilot-security", "branch": "agent/copilot/boss-security", "strengths": ["security", "bugfix", "test"] },
    "copilot-perf": { "provider": "copilot", "enabled": true, "worktree": "../gf-boss-copilot-perf", "branch": "agent/copilot/boss-perf", "strengths": ["refactor", "bugfix", "feature"] },
    "copilot-design": { "provider": "copilot", "enabled": true, "worktree": "../gf-boss-copilot-design", "branch": "agent/copilot/boss-design", "strengths": ["feature", "refactor", "docs"] },
    "codex":   { "provider": "codex",   "enabled": false, "worktree": "../gf-codex",   "branch": "agent/codex/work",   "strengths": ["feature", "bugfix", "test"] },
    "gemini":  { "provider": "gemini",  "enabled": false, "worktree": "../gf-gemini",  "branch": "agent/gemini/work",  "strengths": ["docs", "feature", "chore"] }
  },
  "models": {
    "claude":  { "deep": "opus", "balanced": "sonnet", "fast": "haiku" },
    "copilot": { "deep": "auto", "balanced": "auto", "fast": "auto" }
  },
  "pr": { "everyMerges": 5, "autoMerge": false, "title": "Agent team: GhostForge improvements" },
  "tickSeconds": 20,
  "taskTimeoutMinutes": 60,
  "maxAttempts": 3,
  "cooldownMinutes": 20,
  "fullHealthEveryMinutes": 30
}
