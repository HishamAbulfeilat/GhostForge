#!/usr/bin/env bash
# npm installs package bins as symlinks (npm i -g, npm link), so resolve the
# link chain to find this file's real location before looking for the repo.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$LINK_DIR/$SOURCE" ;;
  esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
exec "$SCRIPT_DIR/ghostforge" "$@"
